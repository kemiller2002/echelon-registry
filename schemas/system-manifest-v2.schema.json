{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/echelon.system.v2.json",
  "title": "Echelon System Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "displayName",
    "repository",
    "status",
    "aliases",
    "executableAliases",
    "distributionClasses",
    "provides",
    "optionalConsumes"
  ],
  "properties": {
    "schema": {
      "const": "echelon.system/v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9._-]+$"
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "predecessor"
      ]
    },
    "successorSystemId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "executableAliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "distributionClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "self-contained-native-cli",
          "self-contained-native-daemon",
          "repository-lifecycle",
          "nuget-library",
          "web-package",
          "contract-bundle",
          "application-artifact"
        ]
      }
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "optionalConsumes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\\\.[a-z][a-z0-9-]*)+$"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contractVersion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\\\.[a-z][a-z0-9-]*)+$"
        },
        "contractVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
