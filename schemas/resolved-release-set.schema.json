{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/echelon.resolved-release-set.v1.json",
  "title": "Echelon Resolved Release Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "platform",
    "resolver",
    "catalogSnapshot",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "echelon.resolved-release-set/v1"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "catalogSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "capabilities": {
      "description": "REG-PAIR-001: the state of each capability pairing the profile declares, on this platform. Present only when the profile declares capabilityPairings. enabled: the host and paired selections both satisfy their ranges. inactive: the host selection does not enable the capability. disabled: the catalog snapshot records the capability as disabled (reason given). A set that would enable the host side without the paired side is never produced.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "host",
          "requires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "state": {
            "enum": [
              "enabled",
              "inactive",
              "disabled"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "systemId",
              "range",
              "selected"
            ],
            "properties": {
              "systemId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "range": {
                "type": "string",
                "minLength": 1
              },
              "selected": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The version this set selects, or null when the component is not in this platform's set."
              }
            }
          },
          "requires": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "systemId",
              "range",
              "selected"
            ],
            "properties": {
              "systemId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "range": {
                "type": "string",
                "minLength": 1
              },
              "selected": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The version this set selects, or null when the component is not in this platform's set."
              }
            }
          }
        },
        "if": {
          "properties": {
            "state": {
              "const": "disabled"
            }
          }
        },
        "then": {
          "required": [
            "reason"
          ]
        },
        "else": {
          "not": {
            "required": [
              "reason"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "platform",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemId",
        "role",
        "required",
        "version",
        "repository",
        "tag",
        "commit",
        "releaseStage",
        "lifecycleState",
        "distributionClass",
        "executable",
        "releaseManifest",
        "distribution",
        "artifacts"
      ],
      "properties": {
        "systemId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "role": {
          "enum": [
            "host-tool",
            "host-daemon",
            "repository-lifecycle",
            "project-binding",
            "contract-bundle",
            "application"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9._-]+$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "releaseStage": {
          "enum": [
            "stable",
            "preview",
            "nightly"
          ]
        },
        "lifecycleState": {
          "const": "active"
        },
        "distributionClass": {
          "enum": [
            "self-contained-native-cli",
            "self-contained-native-daemon",
            "repository-lifecycle",
            "nuget-library",
            "web-package",
            "contract-bundle",
            "application-artifact"
          ]
        },
        "releaseManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "sha256"
          ],
          "properties": {
            "schema": {
              "enum": [
                "echelon.release/v1",
                "echelon.release/v2"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mechanism"
          ],
          "properties": {
            "mechanism": {
              "type": "string",
              "minLength": 1
            },
            "package": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "repositoryLifecycle": {
          "description": "Present only when the selected release provides the echelon.repository-lifecycle capability. See spec/repository-lifecycle-contract.md.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract",
            "contractVersion"
          ],
          "properties": {
            "contract": {
              "const": "echelon.repository-lifecycle"
            },
            "contractVersion": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
