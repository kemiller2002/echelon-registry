{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.com/schemas/echelon.release.v1.json",
  "title": "echelon.release/v1",
  "description": "Machine-readable metadata for one released version of an Echelon system, emitted by its release workflow and attached to the release. Separate from echelon.system/v1 (which describes the system, not a release) so artifact-level facts never overload system fields. Installers (Conditor) and inventories (Project Administration) derive system id, canonical repository, version, executable, capabilities and artifact digests from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "systemId", "version", "repository", "tag", "executable", "distributions", "artifacts"],
  "properties": {
    "schema": { "const": "echelon.release/v1" },
    "systemId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
    "tag": { "type": "string", "minLength": 1 },
    "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "executable": { "type": "string", "description": "Canonical executable name." },
    "compatibilityAliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "provides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "contractVersion"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
          "contractVersion": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["channel"],
        "additionalProperties": false,
        "properties": {
          "channel": { "enum": ["github-release", "npm", "nuget"] },
          "package": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"], "format": "uri" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "platform": { "type": ["string", "null"], "description": ".NET runtime identifier, e.g. linux-x64, osx-arm64, win-x64." },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
