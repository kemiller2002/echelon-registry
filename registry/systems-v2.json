  "plannedCapabilities": [
    {
      "id": "time-primitives",
      "displayName": "Canonical time primitives",
      "description": "Shared Instant, Clock and date-only/calendar semantics for Echelon systems. Not implemented: no library or contract exists yet. Chrona owns it as a separately packaged library inside the chrona repository, not inside the time-entry application; Vigila defines its own local Instant/Clock until then.",
      "capabilities": [],
      "plannedOwner": "chrona",
      "status": "planned",
      "decision": "QDI-079 (amended 2026-10-05)",
      "prerequisites": [
        "separately packaged library in chrona (working name Chrona.Time); Vigila first consumer"
      ],
      "previouslyUnownedSince": "QDI-079",
      "previouslyAssumedOwner": "chrona",
      "nextAction": "Chrona builds Chrona.Time as a separately packaged library in the chrona repository; Vigila adopts it as the first consumer. No system provides this capability until it is implemented."
    },
    {
      "id": "ledger-receivables-payments",
      "displayName": "Ledger, invoicing, receivables and payments",
      "description": "Financial ledger, billing, invoicing, receivables and payment recording. Not implemented: requirements exist only as Summa input documents. Summa owns it, gated on Summa's foundation.",
      "capabilities": [
        "billing.record",
        "invoice.create",
        "payment.record"
      ],
      "plannedOwner": "summa",
      "status": "planned",
      "decision": "QDI-079 (amended 2026-10-05)",
      "prerequisites": [
        "Summa foundation replaces copied Node tooling (QDI-071)"
      ],
      "previouslyUnownedSince": "QDI-079",
      "previouslyAssumedOwner": "summa",
      "nextAction": "Summa replaces its copied Node-era tooling with a real foundation (QDI-071), then implements ledger/invoicing/receivables/payments. Summa must not list billing.record, invoice.create or payment.record in provides until they are implemented."
    }
